# HITEC Smart Campus — environment template. Copy to .env and fill in.
# Never commit .env to git.

# Server
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=0

# Database (SQLite file; override path if needed)
DB_PATH=./data/hitec.db

# Email (Phase 6 notifications). Leave empty = log-only demo mode.
# Free-tier options: Brevo (300/day free), Resend (100/day free)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# SMS (Phase 2 of notifications) — requires a Pakistani gateway; NOT free.
SMS_PROVIDER=
SMS_API_KEY=
